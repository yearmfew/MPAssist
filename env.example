# MPAssist Environment Variables

# IONOS AI Model Hub API Token
IONOS_API_TOKEN=your-ionos-api-token-here

IONOS_API_BASE_URL="https://inference.de-txl.ionos.com"

# Default LLM model to use
LLM_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# Database path
DB_PATH="../db"

# Embedding model
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
